   pub fn push_navigation_stack(&mut self, next_route_id: RouteId, next_active_block: ActiveBlock) {
     info!("navigating to {:?}", next_route_id);
-    if !self
+    if self
       .navigation_stack
       .last()
       .map(|last_route| last_route.id == next_route_id)
       .unwrap_or(false)
     {
-      self.navigation_stack.push(Route {
-        id: next_route_id,
-        active_block: next_active_block,
-        hovered_block: next_active_block,
-      });
-      self.display_revisions.bump(DisplayDomain::Route);
+      return;
     }
+
+    let replace_viewer = self
+      .navigation_stack
+      .last()
+      .map(|last_route| Self::is_viewer_route(&last_route.id))
+      .unwrap_or(false)
+      && Self::is_viewer_route(&next_route_id);
+    if replace_viewer {
+      if let Some(last_route) = self.navigation_stack.last_mut() {
+        info!("replacing fullscreen view with {:?}", next_route_id);
+        last_route.id = next_route_id;
+        last_route.active_block = next_active_block;
+        last_route.hovered_block = next_active_block;
+        self.display_revisions.bump(DisplayDomain::Route);
+      }
+      return;
+    }
+
+    self.navigation_stack.push(Route {
+      id: next_route_id,
+      active_block: next_active_block,
+      hovered_block: next_active_block,
+    });
+    self.display_revisions.bump(DisplayDomain::Route);
   }
 
