+  #[test]
+  fn fullscreen_viewers_replace_each_other() {
+    let mut app = make_app_simple();
+    app.push_navigation_stack(RouteId::LyricsView, ActiveBlock::LyricsView);
+    app.push_navigation_stack(RouteId::Analysis, ActiveBlock::Analysis);
+    app.push_navigation_stack(RouteId::PluginScreen("lyrics".to_string()), ActiveBlock::PluginScreen);
+    app.push_navigation_stack(RouteId::LyricsView, ActiveBlock::LyricsView);
+    assert_eq!(app.get_current_route().id, RouteId::LyricsView);
+    assert_eq!(app.navigation_stack.len(), 2);
+    app.pop_navigation_stack();
+    assert_eq!(app.get_current_route().id, RouteId::Home);
+  }
