+  /// Full-screen viewer routes are mutually exclusive: moving from one to
+  /// another (lyrics -> visualizer -> lyrics) replaces the current frame
+  /// instead of stacking another one. `q` then returns to the screen the
+  /// viewer was opened from, not through every viewer visited in between.
+  fn is_viewer_route(route: &RouteId) -> bool {
+    matches!(
+      route,
+      RouteId::Analysis
+        | RouteId::LyricsView
+        | RouteId::CoverArtView
+        | RouteId::MiniPlayer
+        | RouteId::PluginScreen(_)
+    )
+  }
+
   // The navigation_stack actually only controls the large block to the right of `library` and
